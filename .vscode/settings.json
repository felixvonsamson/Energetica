{
  // General
  "editor.detectIndentation": false,
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    ".hg/store/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "*/.hg/store/**": true,
    ".venv": true,
    "node_modules": true,
    "__pycache__": true,
    ".ruff_cache": true,
    "**/*.egg-info": true,
    "instance": true
  },
  "files.exclude": {
    ".git": true,
    ".venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/dist*": true,
    "instance": true,
    "admin_accounts.txt": true
  },
  "search.exclude": {
    ".git": true,
    ".venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/dist*": true,
    "instance": true,
    "admin_accounts.txt": true
  },
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  // CSS
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "css.customData": [".vscode/css-custom-data.json"],
  // MDX
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Javascript
  "js/ts.implicitProjectConfig.checkJs": true,
  "js/ts.format.enabled": true,
  "js/ts.format.semicolons": "insert",
  "[javascript]": {
    "editor.defaultFormatter": null,
    "editor.wordWrapColumn": 120,
    "editor.rulers": [120]
  },
  // Typescript
  "js/ts.tsdk.path": "./frontend/node_modules/typescript/lib",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "[typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  // Python
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "[python]": {
    "editor.rulers": [120],
    "editor.codeActionsOnSave": {
      // TODO(mglst): source.organizeImports was causing conflicts. Look
      // Into renabling it somehow, perhaps explicitly calling Ruff
      // "source.organizeImports": "always",
      "source.fixAll": "always"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.analysis.autoImportCompletions": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.diagnosticMode": "workspace",
  // JSON
  "json.format.keepLines": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Markdown
  "markdown.validate.enabled": true,
  // cSpell
  "cSpell.language": "en-GB",
