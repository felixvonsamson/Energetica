// Pyright's configuration for every Python file in the repository: the backend and scripts/. It
// lives at the root, not in the backend's pyproject.toml, so that one configuration covers the
// whole Python tree (#1095). Pyright reads comments in this file.
{
    "include": ["src", "tests", "scripts", "main.py", "main_lobby.py"],
    // Resolve `energetica` / `lobby_service` from the source tree. An editable install points at
    // them through a generated import hook that pyright cannot follow, so name the directory here.
    "extraPaths": ["src"],
    "pythonVersion": "3.12",
    "typeCheckingMode": "standard",
    // Resolve imports against the project venv so a bare `pyright` sees installed deps
    // (pydantic, pytest, …) instead of flooding reportMissingImports against its own bundled
    // environment. CI still passes --pythonpath explicitly as belt-and-suspenders.
    "venvPath": ".",
    "venv": ".venv"
}
