# The lobby service (ADR-0009): the one process that opens lobby.db. It owns accounts, sessions,
# memberships and the session-signing secret, and serves them over the socket in
# energetica-lobby-service.socket. It has no network port.
#
# Installed once per VPS by scripts/infra/setup-base.sh into
# /etc/systemd/system/energetica-lobby-service.service. Not enabled on its own: the socket starts
# it on the first connection. The code ships with the lobby, from /var/www/energetica-lobby, and
# scripts/deploy-lobby.sh restarts this unit.
#
# On start it runs any pending schema migrations before serving. Connections that arrive
# meanwhile wait on the socket.
#
# It runs as its own user, created by setup-base.sh, which alone can read lobby.db and the signing
# secret in /var/lib/energetica-lobby-service (0700). The supplementary group energetica lets it
# read its code, which the deploy user owns with group energetica.
#
# The Environment= lines are the contract with src/lobby_service/config.py and
# src/lobby_service/session.py.

[Unit]
Description=Energetica lobby service (accounts, sessions, memberships)
Requires=energetica-lobby-service.socket
After=energetica-lobby-service.socket

[Service]
Type=simple
User=energetica-lobby-service
Group=energetica-lobby-service
SupplementaryGroups=energetica
WorkingDirectory=/var/www/energetica-lobby

Environment=ENERGETICA_LOBBY_DB_PATH=/var/lib/energetica-lobby-service/lobby.db
Environment=ENERGETICA_SHARED_SECRET_PATH=/var/lib/energetica-lobby-service/secret_key.txt

# systemd passes the listening socket as file descriptor 3.
ExecStart=/var/www/energetica-lobby/.venv/bin/python main_lobby_service.py --fd 3
Restart=on-failure
RestartSec=5
