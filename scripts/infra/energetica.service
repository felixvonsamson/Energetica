# systemd unit template for a single game instance.
#
# Rendered by scripts/infra/setup-instance.sh into
# /etc/systemd/system/energetica-@INSTANCE@.service, substituting @INSTANCE@ — and nothing
# else. Every other per-instance value lives in the EnvironmentFile below, so two instances
# differ in this file only by name.
#
# The EnvironmentFile= line is load-bearing. It carries the contract between the deployment and
# src/energetica/instance_config.py + src/energetica/accounts/db.py, and it supplies the three
# values ExecStart expands into main.py flags. It has no `-` prefix, so a missing or unreadable
# file stops the unit rather than starting an instance with no ENERGETICA_INSTANCE_SLUG — which
# would treat itself as public, never read its own instance.json and never publish a landing
# fragment. systemd reads the file as root, before dropping to User=energetica below.
# See scripts/infra/instance.env.tmpl and
# docs/architecture/static-serving-and-deployment.md § What FastAPI gains.

[Unit]
Description=Energetica game instance (@INSTANCE@)
After=network.target

[Service]
Type=simple
# Runs as a member of the shared `energetica` group so it can write its sanitised
# fragment into the setgid landing dir /var/www/energetica-landing/instances/.
User=energetica
Group=energetica
WorkingDirectory=/var/www/energetica-@INSTANCE@

EnvironmentFile=/etc/energetica/@INSTANCE@/instance.env

ExecStart=/var/www/energetica-@INSTANCE@/.venv/bin/python main.py --env prod --port ${ENERGETICA_PORT} --clock_time ${ENERGETICA_CLOCK_TIME} --in_game_seconds_per_tick ${ENERGETICA_IN_GAME_SECONDS_PER_TICK} --no-reload --fastapi-log-level warning
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
