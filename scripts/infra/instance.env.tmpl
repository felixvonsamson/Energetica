# Runtime configuration for the Energetica game instance "@INSTANCE@".
#
# Rendered by scripts/infra/setup-instance.sh into /etc/energetica/@INSTANCE@/instance.env and
# read by /etc/systemd/system/energetica-@INSTANCE@.service through EnvironmentFile=.
#
# This file is the single source of truth for how this instance runs. Everything the unit needs
# beyond the instance's own name lives here, which makes the unit identical for every instance
# and makes this the one file an operator edits. It also makes the values *discoverable*: it is
# root-owned but group-readable by `energetica`, and the `deploy` user is in that group
# (setup-base.sh), so reading the port is a plain read with no sudo at all. Before #1072 the port
# existed only inside the rendered unit and the rendered vhost — two copies and no source of
# truth to regenerate either one from.
#
# The unit does not tolerate this file going missing; see energetica.service for why.
#
# Edits take effect on the next `systemctl restart energetica-@INSTANCE@`, with one exception:
# the engine reads ENERGETICA_CLOCK_TIME and ENERGETICA_IN_GAME_SECONDS_PER_TICK once, at
# init_instance() on the instance's very first tick, and never again. Changing those two for an
# instance that has already ticked does nothing.

# The contract with src/energetica/instance_config.py and src/energetica/accounts/db.py.
# ENERGETICA_INSTANCE_SLUG is mandatory (see above). The other three match the code defaults,
# but are set explicitly so this file, not the code, says where shared state lives.
ENERGETICA_INSTANCE_SLUG=@INSTANCE@
ENERGETICA_INSTANCE_CONFIG_DIR=/etc/energetica
ENERGETICA_LANDING_DIR=/var/www/energetica-landing
ENERGETICA_ACCOUNTS_DB_PATH=/var/lib/energetica/accounts.db

# Read by systemd rather than by the application: the unit expands each one into the matching
# main.py flag in ExecStart. Their values must stay within main.py's argparse choices — see the
# lists setup-instance.sh validates against.
ENERGETICA_PORT=@PORT@
ENERGETICA_CLOCK_TIME=@CLOCK_TIME@
ENERGETICA_IN_GAME_SECONDS_PER_TICK=@IN_GAME_SECONDS_PER_TICK@
