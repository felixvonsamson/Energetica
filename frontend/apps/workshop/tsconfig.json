{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["vite/client", "vite-plugin-svgr/client"],
        // `@api` is how shared packages, such as @energetica/instance, reach this
        // app's API types: the Workshop's own.
        "paths": {
            "@/*": ["./src/*"],
            "@api": ["./src/types/api-helpers.ts"]
        }
    },
    "include": ["src"]
}
