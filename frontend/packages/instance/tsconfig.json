{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // `?react` SVG imports, which every app's Vite config turns into components.
        "types": ["vite/client", "vite-plugin-svgr/client"],
        // Each app compiles this package against its own API types, through its own
        // `@api` alias. This mapping only serves this package's own typecheck, lint and
        // editor, which need some app's types: the persistent world's, which serves
        // every route the package calls.
        "paths": { "@api": ["../../apps/freeplay/src/types/api-helpers.ts"] }
    },
    "include": ["src"]
}
