{
    "type": "module",
    "private": true,
    "workspaces": {
        "packages": ["packages/*"],
        "catalog": {
            "@radix-ui/react-dialog": "^1.1.15",
            "@tanstack/react-query": "^5.90.12",
            "@types/react": "^19.2.7",
            "@types/react-dom": "^19.2.3",
            "lucide-react": "^0.562.0",
            "react": "^19.2.3",
            "react-dom": "^19.2.3",
            "sonner": "^2.0.7",
            "tailwindcss": "^4.1.12",
            "typescript": "^5.9.3",
            "vite": "^7.2.7",
            "vite-plugin-svgr": "^4.5.0",
            "vitest": "^4.1.10"
        }
    },
    "scripts": {
        "dev:app": "vite",
        "dev:landing": "vite --config vite.config.landing.ts",
        "dev:lobby": "vite --config vite.config.lobby.ts",
        "// build:app": "Not a script — a note. The order matters: the build deletes dist-app/ before writing it, so build:sw must follow it, never precede it. See the emptyOutDir comment in vite.config.ts.",
        "build:app": "vite build && bun run build:sw",
        "build:landing": "vite build --config vite.config.landing.ts && mv dist-landing/index.landing.html dist-landing/index.html",
        "build:lobby": "vite build --config vite.config.lobby.ts && mv dist-lobby/index.lobby.html dist-lobby/index.html",
        "build:all": "bun run build:app && bun run build:landing && bun run build:lobby",
        "build:sw": "bun build src/service-worker.ts --outfile dist-app/service-worker.js --target browser && { printf '// AUTO-GENERATED — do not edit. Run `bun run build:sw` in frontend/ to regenerate.\\n'; cat dist-app/service-worker.js; } > /tmp/sw.js && mv /tmp/sw.js dist-app/service-worker.js",
        "dev:sw": "bun build src/service-worker.ts --outfile dist-app/service-worker.js --target browser --watch",
        "generate-types": "bash ../scripts/generate-types.sh",
        "lint": "eslint . --max-warnings 0 --cache",
        "lint:fix": "eslint . --fix --cache",
        "format": "prettier --write \"./**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"./**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.landing.json && tsc --noEmit --project tsconfig.lobby.json && tsc --noEmit --project tsconfig.sw.json && bun run --filter './packages/*' typecheck",
        "typecheck:watch": "tsc --noEmit --watch",
        "guard:no-raw-html": "bun ../scripts/guard-no-raw-html.ts",
        "guard:filenames": "bun ../scripts/guard-filenames.ts",
        "guard:no-dummy-data": "bun ../scripts/guard-no-dummy-data.ts",
        "guard:image-weight": "bun ../scripts/guard-image-weight.ts",
        "test": "vitest run && bun run --filter './packages/*' test",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@energetica/core": "workspace:*",
        "@energetica/ui": "workspace:*",
        "@floating-ui/dom": "^1.7.4",
        "@lucide/lab": "^0.1.2",
        "@mdx-js/rollup": "^3.1.1",
        "@radix-ui/react-dialog": "catalog:",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "catalog:",
        "@tanstack/react-router": "^1.141.2",
        "@tanstack/router-plugin": "^1.141.2",
        "d3-scale": "^4.0.2",
        "echarts": "^6.0.0",
        "framer-motion": "^12.38.0",
        "lucide-react": "catalog:",
        "qrcode": "^1.5.4",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "socket.io-client": "^4.8.1",
        "sonner": "catalog:",
        "tailwindcss": "catalog:"
    },
    "devDependencies": {
        "@mdx-js/mdx": "^3.1.1",
        "@mdx-js/typescript-plugin": "^0.1.3",
        "@tanstack/eslint-plugin-query": "^5.91.2",
        "@types/estree": "^1.0.9",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.10.3",
        "@types/qrcode": "^1.5.6",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript-eslint/eslint-plugin": "^8.48.1",
        "@typescript-eslint/parser": "^8.48.1",
        "@vitejs/plugin-react": "^4.7.0",
        "baseline-browser-mapping": "^2.9.7",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^61.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "mdast-util-mdx-jsx": "^3.2.0",
        "mdast-util-mdxjs-esm": "^2.0.1",
        "openapi-typescript": "^7.10.1",
        "prettier": "^3.7.4",
        "prettier-plugin-jsdoc": "^1.8.0",
        "typescript": "catalog:",
        "typescript-eslint": "^8.49.0",
        "unist-util-visit": "^5.1.0",
        "vite": "catalog:",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-svgr": "catalog:",
        "vitest": "catalog:"
    }
}
