{
    "type": "module",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*"
        ],
        "catalog": {
            "@floating-ui/dom": "^1.7.4",
            "@radix-ui/react-dialog": "^1.1.15",
            "@tanstack/react-query": "^5.90.12",
            "@tanstack/react-router": "^1.141.2",
            "@tanstack/router-plugin": "^1.141.2",
            "@types/react": "^19.2.7",
            "@types/react-dom": "^19.2.3",
            "echarts": "^6.0.0",
            "lucide-react": "^0.562.0",
            "react": "^19.2.3",
            "react-dom": "^19.2.3",
            "sonner": "^2.0.7",
            "tailwindcss": "^4.1.12",
            "typescript": "^5.9.3",
            "vite": "^7.2.7",
            "vite-plugin-svgr": "^4.5.0",
            "vitest": "^4.1.10"
        }
    },
    "scripts": {
        "dev:freeplay": "bun run --filter @energetica/freeplay dev",
        "dev:landing": "bun run --filter @energetica/landing dev",
        "dev:lobby": "bun run --filter @energetica/lobby dev",
        "dev:workshop": "bun run --filter @energetica/workshop dev",
        "build:freeplay": "bun run --filter @energetica/freeplay build",
        "build:landing": "bun run --filter @energetica/landing build",
        "build:lobby": "bun run --filter @energetica/lobby build",
        "build:workshop": "bun run --filter @energetica/workshop build",
        "build:all": "bun run build:freeplay && bun run build:landing && bun run build:lobby && bun run build:workshop",
        "generate-types": "bash ../scripts/generate-types.sh",
        "lint": "eslint . --max-warnings 0 --cache",
        "lint:fix": "eslint . --fix --cache",
        "typecheck": "tsc --noEmit && bun run --filter './apps/*' --filter './packages/*' typecheck",
        "guard:no-raw-html": "bun ../scripts/guard-no-raw-html.ts",
        "guard:filenames": "bun ../scripts/guard-filenames.ts",
        "guard:no-dummy-data": "bun ../scripts/guard-no-dummy-data.ts",
        "guard:image-weight": "bun ../scripts/guard-image-weight.ts",
        "test": "vitest run && bun run --filter './apps/*' --filter './packages/*' test",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@mdx-js/typescript-plugin": "^0.1.3",
        "@tanstack/eslint-plugin-query": "^5.91.2",
        "@types/node": "^24.10.3",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript-eslint/eslint-plugin": "^8.48.1",
        "@typescript-eslint/parser": "^8.48.1",
        "@vitejs/plugin-react": "^4.7.0",
        "baseline-browser-mapping": "^2.9.7",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-better-tailwindcss": "^4.11.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^61.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "openapi-typescript": "^7.10.1",
        "prettier": "^3.7.4",
        "prettier-plugin-jsdoc": "^1.8.0",
        "typescript": "catalog:",
        "typescript-eslint": "^8.49.0",
        "vite": "catalog:",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-svgr": "catalog:",
        "vitest": "catalog:"
    }
}
